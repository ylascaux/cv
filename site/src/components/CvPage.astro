---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyMark from './CompanyMark.astro';
import Icon from './Icon.astro';
import { formatPeriod, translations } from '../lib/i18n';
import type { Cv, Education, Link, TimedEntry } from '../lib/types';

type Volunteering = Cv['volunteering'][number];
type SkillGroup = Cv['skills'][number];
type Skill = SkillGroup['items'][number];
type Language = Cv['languages'][number];

interface Props {
  cv: Cv;
}

const { cv } = Astro.props;
const locale = cv.metadata.locale;
const t = translations[locale];
const homeHref = locale === 'fr' ? '/' : '/en/';
const description = `${cv.profile.name} — ${cv.profile.title}. ${cv.profile.summary}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.profile.name,
  jobTitle: cv.profile.title,
  address: cv.profile.location,
  email: cv.profile.email,
  sameAs: cv.profile.links.map(({ url }: Link) => url),
};
---

<BaseLayout locale={locale} title={`${cv.profile.name} — ${cv.profile.title}`} description={description}>
  <a class="skip-link" href="#main">{t.skip}</a>

  <header class="site-header">
    <div class="header-inner">
      <div class="header-top">
        <div class="header-title">
          <a class="identity" href={homeHref} aria-label={cv.profile.name}>
            <span class="profile-name">{cv.profile.name}</span>
          </a>
          <h1 id="page-title">{cv.profile.title}</h1>
        </div>
        <ul class="header-details" aria-label={locale === 'fr' ? 'Informations personnelles' : 'Personal details'}>
          <li>
            <svg class="detail-icon" aria-hidden="true" viewBox="0 0 24 24"
              ><path
                d="M9 6V4h6v2h5a2 2 0 0 1 2 2v3H2V8a2 2 0 0 1 2-2h5Zm13 7v5a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5h8v1h4v-1h8Z"
              ></path></svg
            >
            {cv.profile.status}
          </li>
          <li>
            <svg class="detail-icon" aria-hidden="true" viewBox="0 0 24 24"
              ><path
                d="M12 2a7 7 0 0 1 7 7c0 5.25-7 13-7 13S5 14.25 5 9a7 7 0 0 1 7-7Zm0 4.5A2.5 2.5 0 1 0 12 11a2.5 2.5 0 0 0 0-5Z"
              ></path></svg
            >
            {cv.profile.location}
          </li>
          <li>
            <svg class="detail-icon" aria-hidden="true" viewBox="0 0 24 24"
              ><path
                d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 4v2h7V8H6Zm0 5v2h4v-2H6Zm10-5v7h2V8h-2Z"
              ></path></svg
            >
            {cv.profile.driverLicense}
          </li>
          {
            cv.profile.links.map((link: Link) => (
              <li>
                <Icon class="detail-icon" name={link.label.toLowerCase() === 'linkedin' ? 'linkedin' : 'link'} />
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="download-item">
            <a
              class="download-button"
              href={t.downloadPath}
              download
              aria-label={t.downloadPdf}
              data-testid="download-pdf"
            >
              <svg class="detail-icon" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M11 3h2v10.2l3.6-3.6 1.4 1.4-6 6-6-6 1.4-1.4 3.6 3.6V3ZM4 19h16v2H4v-2Z"></path>
              </svg>
              {t.downloadPdfShort}
            </a>
          </li>
          <li class="contact-item">
            <a class="contact-button" href={`mailto:${cv.profile.email}`}>
              <svg class="detail-icon" aria-hidden="true" viewBox="0 0 24 24"
                ><path
                  d="M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm9 7.2L20 7H4l8 5.2ZM3 9v8h18V9l-9 5.8L3 9Z"
                ></path></svg
              >
              <span class="contact-label">{t.contact}</span>
              <span class="contact-email">{cv.profile.email}</span>
            </a>
          </li>
        </ul>
      </div>
      <nav aria-label={locale === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        <a href="#profile">{t.about}</a>
        <a href="#experience">{t.experience}</a>
        <a href="#education">{t.education}</a>
        <a href="#skills">{t.skills}</a>
        <span
          class="locale-switcher"
          role="group"
          aria-label={locale === 'fr' ? 'Choix de la langue' : 'Language selection'}
        >
          <a
            class={locale === 'fr' ? 'language-current' : 'language-link'}
            href="/"
            lang="fr"
            aria-current={locale === 'fr' ? 'page' : undefined}
          >
            FR
          </a>
          <a
            class={locale === 'en' ? 'language-current' : 'language-link'}
            href="/en/"
            lang="en"
            aria-current={locale === 'en' ? 'page' : undefined}
          >
            EN
          </a>
        </span>
        <button
          class="theme-toggle"
          type="button"
          aria-label={t.enableDarkTheme}
          title={t.enableDarkTheme}
          data-dark-label={t.enableDarkTheme}
          data-light-label={t.enableLightTheme}
          data-testid="theme-toggle"
        >
          <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M20.4 15.5A8.5 8.5 0 0 1 8.5 3.6 8.5 8.5 0 1 0 20.4 15.5Z"></path>
          </svg>
          <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24">
            <path
              d="M11 1h2v3h-2V1Zm0 19h2v3h-2v-3ZM3.5 2.1l2.1 2.1-1.4 1.4-2.1-2.1 1.4-1.4Zm14.9 14.9 2.1 2.1-1.4 1.4-2.1-2.1 1.4-1.4ZM1 11h3v2H1v-2Zm19 0h3v2h-3v-2ZM4.2 18.4l1.4 1.4-2.1 2.1-1.4-1.4 2.1-2.1ZM18.4 5.6 17 4.2l2.1-2.1 1.4 1.4-2.1 2.1ZM12 6a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z"
            ></path>
          </svg>
        </button>
      </nav>
    </div>
  </header>

  <main id="main" aria-labelledby="page-title">
    <div class="resume-layout">
      <aside class="sidebar" aria-label={locale === 'fr' ? 'Profil et langues' : 'Profile and languages'}>
        <div class="sidebar-accent" aria-hidden="true"></div>

        <section id="profile" class="sidebar-section" aria-labelledby="profile-title">
          <h2 id="profile-title" class="sidebar-title">{t.about}</h2>
          <p class="profile-summary">{cv.profile.summary}</p>
        </section>

        <section id="languages" class="sidebar-section languages" aria-labelledby="languages-title">
          <h2 id="languages-title" class="sidebar-title">{t.languages}</h2>
          <dl>
            {
              cv.languages.map((language: Language) => (
                <div>
                  <dt>{language.name}</dt>
                  <dd>{language.level}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </aside>

      <div class="main-column">
        <section id="experience" class="section" aria-labelledby="experience-title">
          <div class="section-heading">
            <Icon class="section-icon" name="briefcase" />
            <h2 id="experience-title">{t.experience}</h2>
          </div>
          <div class="entries experience-entries">
            {
              cv.experiences.map((experience: TimedEntry) => (
                <article class:list={['entry', 'experience-entry', { 'is-current': !experience.endDate }]}>
                  <header class="entry-header">
                    <div class="entry-identity">
                      <CompanyMark id={experience.id} organization={experience.organization} />
                      <div>
                        <div class="role-line">
                          <h3>{experience.role}</h3>
                          {!experience.endDate && <span class="current-role">{t.currentRole}</span>}
                        </div>
                        <p class="organization">{experience.organization}</p>
                      </div>
                    </div>
                    <div class="entry-meta">
                      <time>{formatPeriod(experience.startDate, experience.endDate, locale)}</time>
                      {experience.contract && <span>{experience.contract}</span>}
                    </div>
                  </header>
                  <ul class="highlights">
                    {experience.highlights.map((highlight: string) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                  {(experience.details || experience.environment) && (
                    <details class="experience-details">
                      <summary>{t.moreDetails}</summary>
                      <div class="experience-details-content">
                        {experience.details && (
                          <div class="experience-details-section additional-responsibilities">
                            <p>{t.additionalResponsibilities}</p>
                            <ul class="highlights">
                              {experience.details.map((detail: string) => (
                                <li>{detail}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {experience.environment && (
                          <div class="experience-details-section technical-environment">
                            <p>{t.technicalEnvironment}</p>
                            <ul class="environment-tags" aria-label={t.technicalEnvironment}>
                              {experience.environment.map((technology: string) => (
                                <li>{technology}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    </details>
                  )}
                  {experience.details && (
                    <ul class="highlights print-details" aria-label={t.additionalResponsibilities}>
                      {experience.details.map((detail: string) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  )}
                </article>
              ))
            }
          </div>
        </section>

        <section id="education" class="section" aria-labelledby="education-title">
          <div class="section-heading">
            <Icon class="section-icon" name="education" />
            <h2 id="education-title">{t.education}</h2>
          </div>
          <div class="entries">
            {
              cv.education.map((education: Education) => (
                <article class="entry education-entry">
                  <header class="entry-header">
                    <div>
                      <h3>{education.title}</h3>
                      <p class="organization">{education.institution}</p>
                    </div>
                    <time class="entry-meta">{formatPeriod(education.startDate, education.endDate, locale)}</time>
                  </header>
                  <p>{education.description}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section id="volunteering" class="section" aria-labelledby="volunteering-title">
          <div class="section-heading">
            <Icon class="section-icon" name="volunteering" />
            <h2 id="volunteering-title">{t.volunteering}</h2>
          </div>
          <div class="entries volunteering-entries">
            {
              cv.volunteering.map((entry: Volunteering) => (
                <article class="entry volunteering-card">
                  <header class="volunteering-header">
                    <span class="volunteering-mark" aria-hidden="true">
                      <Icon name="school-it" />
                    </span>
                    <div class="volunteering-identity">
                      <h3>{entry.role}</h3>
                      <p class="organization">{entry.organization}</p>
                    </div>
                    <dl class="volunteering-metrics">
                      {entry.metrics.map((metric) => (
                        <div>
                          <dt>{metric.value}</dt>
                          <dd>{metric.label}</dd>
                        </div>
                      ))}
                    </dl>
                  </header>
                  <p class="volunteering-summary">{entry.summary}</p>
                  <ul
                    class="volunteering-areas"
                    aria-label={locale === 'fr' ? "Domaines d'intervention" : 'Areas of responsibility'}
                  >
                    {entry.areas.map((area: string) => (
                      <li>{area}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="skills-sidebar" aria-label={t.skills}>
        <section id="skills" class="section" aria-labelledby="skills-title">
          <div class="section-heading">
            <Icon class="section-icon" name="skills" />
            <h2 id="skills-title">{t.skills}</h2>
          </div>
          <div class="skill-groups">
            {
              cv.skills.map((group: SkillGroup) => (
                <article class="skill-group">
                  <h3>
                    <Icon class="skill-group-icon" name={group.id} />
                    <span>{group.name}</span>
                  </h3>
                  <ul>
                    {group.items.map((skill: Skill) => (
                      <li>
                        <strong>{skill.name}</strong>
                        {skill.details && <span> — {skill.details}</span>}
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>
      </aside>
    </div>
  </main>

  <footer>
    <p>{cv.profile.name} · {cv.profile.title}</p>
  </footer>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline>
    (() => {
      const button = document.querySelector('[data-testid="theme-toggle"]');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      if (!(button instanceof HTMLButtonElement)) return;

      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        const label = theme === 'dark' ? button.dataset.lightLabel : button.dataset.darkLabel;
        if (label) {
          button.setAttribute('aria-label', label);
          button.title = label;
        }
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#15161a' : '#ffffff');
      };

      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

      button.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('cv-theme', theme);
        applyTheme(theme);
      });

      systemTheme.addEventListener('change', (event) => {
        if (localStorage.getItem('cv-theme') === null) applyTheme(event.matches ? 'dark' : 'light');
      });
    })();
  </script>
</BaseLayout>
